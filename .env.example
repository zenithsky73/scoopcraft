# ─── Database ────────────────────────────────────────────────────────────
# Lokal (docker compose up -d):
DATABASE_URL="postgresql://scoopcraft:scoopcraft@localhost:5432/scoopcraft?schema=public"
# Neon / Supabase: pakai connection string dari dashboard (+ ?sslmode=require)

# ─── Auth.js ─────────────────────────────────────────────────────────────
# Buat nilai baru: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Akun pemilik (kuota tanpa batas) ────────────────────────────────────
# Diisi saat `npm run db:seed`. Atau buat kapan saja lewat terminal:
#   npm run owner <email> <password>
OWNER_EMAIL=""
OWNER_PASSWORD=""

# ─── Coba tanpa login ────────────────────────────────────────────────────
# 0 untuk mematikan mode coba
GUEST_TRIAL=1
# Jumlah generate gratis per pengunjung
GUEST_QUOTA=1
# Pagar kedua: berapa percobaan gratis per alamat IP per hari
GUEST_IP_LIMIT=3

# ─── Trial & kuota (modul 6) ─────────────────────────────────────────────
TRIAL_DURATION_DAYS=14
TRIAL_QUOTA=10
# FIRST_EXHAUSTED | DAYS_ONLY | QUOTA_ONLY
TRIAL_MODE=FIRST_EXHAUSTED
# Panjang siklus kuota paket berbayar (hari)
PLAN_RESET_DAYS=30

# ─── Scraper (modul 2) ───────────────────────────────────────────────────
SCRAPER_FETCH_TIMEOUT_MS=12000
SCRAPER_BROWSER_TIMEOUT_MS=30000
SCRAPER_MAX_HTML_BYTES=5000000
# Di bawah nilai ini hasil statis dianggap gagal -> coba Playwright
SCRAPER_MIN_WORDS_STATIC=180
# Di bawah nilai ini hasil akhir ditolak (TOO_SHORT)
SCRAPER_MIN_WORDS_ACCEPT=80
# Set 0 untuk mematikan fallback browser (mis. serverless tanpa Chromium)
SCRAPER_BROWSER_FALLBACK=1

# ─── AI pipeline (Anthropic / Gemini / OpenAI / Mock) ────────────────────
# AI_PROVIDER: anthropic | gemini | openai | mock (otomatis mendeteksi key)
AI_PROVIDER=anthropic

# Google Gemini (Rekomendasi: cepat & hemat biaya)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_EFFORT=medium
AI_MAX_ARTICLE_CHARS=12000

# ─── Queue (modul 3) ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# redis = BullMQ (produksi) | inline = jalan di proses Next, tanpa Redis (dev)
QUEUE_DRIVER=redis
QUEUE_ATTEMPTS=3
WORKER_CONCURRENCY=3

# ─── Visual & design engine (modul 4) ────────────────────────────────────
# URL aplikasi yang dibuka Chromium saat merender kanvas
APP_URL="http://localhost:3000"
# replicate = gambar AI sungguhan (butuh token) | local = latar abstrak tanpa API
# Satu gambar dibuat per slide, jadi carousel 5 slide = 4 gambar.
# gemini | replicate | local
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=""
# gemini-3.1-flash-image (default) | gemini-3-pro-image | gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# 1K (cukup untuk kanvas 1080px) | 2K | 4K
GEMINI_IMAGE_SIZE="1K"
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="black-forest-labs/flux-schnell"
# Skor minimal agar gambar artikel dipakai (0-1); di bawah ini → generate
IMAGE_RELEVANCE_THRESHOLD=0.6
# local = tulis ke public/generated
STORAGE_DRIVER=local
# Jumlah slide carousel bawaan (1 = gambar tunggal, maksimal 7)
SLIDES_DEFAULT=5
