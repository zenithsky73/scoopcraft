{
  "name": "scoopcraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx watch src/worker/index.ts",
    "dev:all": "concurrently -n next,worker -c cyan,magenta \"npm:dev\" \"npm:worker\"",
    "build": "prisma generate && (prisma db push --skip-generate --accept-data-loss || true) && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pipeline": "tsx scripts/pipeline.ts",
    "owner": "tsx scripts/make-owner.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker:prod": "tsx src/worker/index.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@google/genai": "^2.19.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "image-size": "^2.0.2",
    "ioredis": "^6.0.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "openai": "^7.7.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
